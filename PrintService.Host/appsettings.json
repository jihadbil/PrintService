{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Printing": {
    "DocumentEngine": "PrintDocument",
    "MaxCopies": 10,
    "MaxDocumentBytes": 10485760,
    "MaxImagePixels": 25000000,
    "MaxQueuedJobs": 32,
    "MaxConcurrentPrinters": 2,
    "PdfTimeoutSeconds": 60,
    "PdfExecutablePath": null
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://127.0.0.1:5055"
      }
    }
  }
}
